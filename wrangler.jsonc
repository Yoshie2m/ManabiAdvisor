    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "manabi-advisor.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "manabi-advisor",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "manabi-advisor.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "795741603946",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:795741603946:web:a596ef122c81f9b2a72213"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
