rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Content master data (curricula/learningUnits/upcomingExams/questions/buddyCheers):
    // readable by anyone, written only via the Admin SDK or console — there
    // is no client-side content authoring flow.
    match /curricula/{curriculumId} {
      allow read: if true;
      allow write: if false;
    }
    match /learningUnits/{learningUnitId} {
      allow read: if true;
      allow write: if false;
    }
    match /upcomingExams/{examType} {
      allow read: if true;
      allow write: if false;
    }
    match /questions/{questionId} {
      allow read: if true;
      allow write: if false;
    }
    match /buddyCheers/{cheerId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-student data (students/cultivationProgress): StudentId is the
    // Firebase Auth uid (see docs/domain/glossary.md), so each student can
    // only read/write their own documents.
    match /students/{studentId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
    }
    match /cultivationProgress/{studentId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
    }
    match /quizSessions/{studentId}/units/{learningUnitId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
